# Server Configuration
PORT=3000
NODE_ENV=development

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rockfall_db
DB_USER=postgres
DB_PASSWORD=postgrespassword

# MQTT Broker Configuration (2-Way Communication)
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_CLIENT_ID=rockfall_unified_service
MQTT_USER=
MQTT_PASSWORD=
MQTT_TELEMETRY_TOPIC=devices/+/telemetry
MQTT_LORAWAN_TOPIC=lorawan/+/up

# Authentication & Security
JWT_SECRET=rockfall-secret-jwt-key
JWT_EXPIRES_IN=24h

# Initial Super Admin Seed Credentials
INITIAL_ADMIN_EMAIL=admin@rockfall.com
INITIAL_ADMIN_PASSWORD=admin123

# Frontend URLs
VITE_API_URL=http://localhost:3000/api
VITE_WS_URL=ws://localhost:3000/ws
